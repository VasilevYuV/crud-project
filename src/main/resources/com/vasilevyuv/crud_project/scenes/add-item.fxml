<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="addItem" fillWidth="false" prefHeight="100.0" prefWidth="540.0" style="-fx-background-color: rgba(59, 59, 59); -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-style: dashed; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vasilevyuv.crud_project.controller.AddItemController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <!-- кнопка с плюсом -->
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddClick" prefHeight="86.0" prefWidth="490.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: white;" text="+">
        <font>
            <Font size="40.0" />
        </font>
    </Button>

</VBox>
