<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vasilevyuv.crud_project.controller.MainController">

    <!-- Заголовок -->
    <Label alignment="CENTER" layoutX="-1.0" layoutY="14.0" prefHeight="17.0" prefWidth="700.0" text="CRUD Application to manage profiles" textAlignment="CENTER" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
    </Label>

    <!-- Панель поиска и фильтрации -->
    <HBox alignment="CENTER" layoutY="57.0" prefHeight="50.0" prefWidth="700.0" spacing="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="57.0">

        <!-- Поле поиска -->
        <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by name..." />

        <!-- Кнопка сброса -->
        <Button fx:id="clearButton" mnemonicParsing="false" text="Clear" />

        <!-- Информация о количестве -->
        <Label fx:id="countLabel" text="Found: 0" />

    </HBox>

    <!-- Список сущностей -->
    <ScrollPane fx:id="scrollPane" layoutY="117.0" prefHeight="300.0" prefWidth="700.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="117.0">
        <VBox fx:id="entitiesContainer" spacing="10.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets bottom="10.0" left="40.0" right="30.0" top="10.0" />
            </padding>
        </VBox>
      <padding>
         <Insets left="10.0" />
      </padding>
    </ScrollPane>

    <!-- Пагинация -->
    <Pagination fx:id="pagination" layoutY="427.0" prefHeight="50.0" prefWidth="700.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

</AnchorPane>
